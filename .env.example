# Briefly — local configuration. Copy to .env and adjust.
# Every variable is optional in development: the defaults below are what the app uses when unset.

# --- App ---------------------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_NAME=Briefly
LOG_LEVEL=info

# --- Database (PostgreSQL 16) ------------------------------------------------------------------
DATABASE_URL=postgres://postgres@127.0.0.1:5432/briefly
# Tests always use this one, never DATABASE_URL.
DATABASE_URL_TEST=postgres://postgres@127.0.0.1:5432/briefly_test

# --- Auth --------------------------------------------------------------------------------------
# Signs sessions, contribution links and storage URLs. Use a long random value in production.
AUTH_SECRET=development-only-secret-change-me-please
SESSION_TTL_DAYS=30
# The first platform administrator, created by the seed.
SEED_ADMIN_EMAIL=admin@briefly.press
SEED_ADMIN_PASSWORD=briefly-demo

# --- AI ----------------------------------------------------------------------------------------
# "local" is deterministic and needs no network; "openai" needs OPENAI_API_KEY.
AI_PROVIDER=local
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
AI_MODEL_FAST=gpt-4.1-mini
AI_MODEL_STRONG=gpt-4.1
AI_MAX_MONTHLY_BUDGET_EUR=50

# --- Email -------------------------------------------------------------------------------------
# A Gmail mailbox connected in Settings → Email overrides all of this.
# "log" stores every message in the development mailbox instead of sending it.
EMAIL_PROVIDER=log
EMAIL_FROM=Briefly <newsroom@briefly.press>
# RESEND_API_KEY=
# BREVO_API_KEY=
# Optional: enables "Sign in with Google" on Settings → Email.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Billing (optional: without keys every workspace is on the free plan) -----------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PUBLISHABLE_KEY=

# --- Storage -----------------------------------------------------------------------------------
# A bucket connected in Admin → Providers overrides all of this.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage
# STORAGE_S3_BUCKET=
STORAGE_S3_REGION=auto
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# STORAGE_S3_PUBLIC_BASE_URL=
STORAGE_SIGNED_URL_TTL_SECONDS=900
UPLOAD_MAX_FILE_MB=25
UPLOAD_MAX_FILES_PER_SUBMISSION=20

# --- Jobs and automation -----------------------------------------------------------------------
# inprocess (default), cli (run `pnpm worker`) or none.
JOBS_RUNNER=inprocess
JOBS_POLL_INTERVAL_MS=2000
# Protects POST /api/automations/tick for external schedulers.
AUTOMATION_TICK_TOKEN=change-me

# --- Print -------------------------------------------------------------------------------------
# Leave empty to use Playwright's Chromium.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=
PRINT_PAGE_SIZE=A4
